---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import { CATEGORIES } from '../../consts';

const cards = await getCollection('knowledge');
const groups = CATEGORIES.map((c) => ({ ...c, cards: cards.filter((k) => k.data.category === c.slug) }));
---
<Base title="影片重點卡" description="從家電清潔與故障排除教學影片整理的重點卡，每張附原片時間點。">
  <header class="page-head">
    <h1>影片重點卡</h1>
    <p>從品牌官方與維修師傅的教學影片整理，每張附原片時間點，點來源直接看那一段。</p>
  </header>

  <form class="filter" role="search" onsubmit="return false">
    <label for="kq" class="sr-only">搜尋重點卡</label>
    <input id="kq" type="search" placeholder="輸入關鍵字，例如：濾網" />
  </form>
  <p class="none" id="none" hidden>沒有找到符合的卡片，試試別的說法。</p>
  {cards.length === 0 && <p class="none">第一批重點卡整理中。</p>}

  {groups.filter((g) => g.cards.length).map((g) => (
    <section class="cat-group" id={g.slug}>
      <h2>{g.name}</h2>
      <div class="cards">
        {g.cards.map((c) => (
          <div class="item" data-text={[c.data.title, c.data.what, ...(c.data.how ?? [])].join(' ').toLowerCase()}>
            <KnowledgeCard card={c.data} />
          </div>
        ))}
      </div>
    </section>
  ))}
</Base>

<script>
  const input = document.getElementById('kq') as HTMLInputElement;
  const none = document.getElementById('none')!;
  const items = [...document.querySelectorAll<HTMLElement>('.item')];
  const apply = () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    items.forEach((el) => {
      const hit = !q || q.split(/\s+/).every((w) => el.dataset.text!.includes(w));
      el.hidden = !hit;
      if (hit) shown++;
    });
    document.querySelectorAll<HTMLElement>('.cat-group').forEach((g) => {
      g.hidden = !g.querySelector('.item:not([hidden])');
    });
    none.hidden = !(q && items.length && shown === 0);
  };
  const q = new URLSearchParams(location.search).get('q');
  if (q) input.value = q;
  input.addEventListener('input', apply);
  apply();
</script>

<style>
  .filter { margin: 20px 0 8px; max-width: 520px; }
  .filter input { width: 100%; font: inherit; padding: 12px 16px; border: 2px solid var(--ink); border-radius: 6px; background: var(--card); color: var(--ink); }
  .cat-group { padding-block: 32px; }
  .cat-group h2 { font-size: 1.4rem; margin: 0 0 16px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .item { display: flex; min-width: 0; }
  .item > :global(*) { flex: 1; }
  @media (max-width: 860px) { .cards { grid-template-columns: minmax(0, 1fr); } }
</style>
