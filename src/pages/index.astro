---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FloorPlan from '../components/FloorPlan.astro';
import { CATEGORIES } from '../consts';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = articles.slice(0, 6);
---
<Base>
  <section class="hero">
    <div>
      <h1>家電出狀況，<br />先查這裡</h1>
      <p class="lede">冷氣閃燈、洗衣機跳錯誤碼、除濕機不除濕、鐵鍋生鏽。對照原廠說明書和教學影片整理成看得懂的中文，每一條都標來源。</p>
      <ul class="cats">
        {CATEGORIES.map((c) => (
          <li><a href={`/category/${c.slug}/`}><b>{c.name}</b><span>{c.note}</span></a></li>
        ))}
      </ul>
    </div>
    <FloorPlan />
  </section>

  <section class="block">
    <h2>最新整理</h2>
    {latest.length > 0 ? (
      <ul class="list">
        {latest.map((a) => (
          <li><a href={`/articles/${a.id}/`}>{a.data.title}</a><p>{a.data.description}</p></li>
        ))}
      </ul>
    ) : (
      <p class="none">第一批內容整理中：冷氣錯誤碼與濾網清洗會先上。</p>
    )}
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 48px; align-items: center; padding-block: 32px 56px; }
  h1 { font-size: clamp(2.1rem, 5.2vw, 3.4rem); line-height: 1.22; margin: 0 0 18px; }
  .lede { font-size: 1.08rem; color: var(--muted); max-width: 30em; margin: 0 0 24px; }
  .cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; max-width: 32em; }
  .cats a { display: grid; grid-template-columns: 7.5em 1fr; gap: 12px; padding: 8px 0; text-decoration: none; border-bottom: 1px dashed var(--rule); }
  .cats a:hover b { color: var(--tile); }
  .cats span { color: var(--muted); font-size: .92rem; }
  .block { padding-block: 40px; border-top: 1px solid var(--rule); }
  .block h2 { font-size: 1.6rem; margin: 0 0 16px; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; max-width: 46em; }
  .list a { font-weight: 600; font-size: 1.05rem; }
  .list p { margin: 2px 0 0; color: var(--muted); }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 420px) { .cats a { grid-template-columns: 1fr; gap: 0; } }
</style>
