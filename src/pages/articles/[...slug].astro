---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleRail from '../../components/ArticleRail.astro';
import { CATEGORIES, KINDS, SITE_NAME, SITE_URL } from '../../consts';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const d = article.data;
const category = CATEGORIES.find((c) => c.slug === d.category)!;
const og = d.cover ? await getImage({ src: d.cover, width: 1200, format: 'jpg' }) : undefined;
const fmt = (date: Date) => date.toISOString().slice(0, 10);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: fmt(d.pubDate),
  dateModified: fmt(d.updatedDate ?? d.pubDate),
  inLanguage: 'zh-Hant-TW',
  mainEntityOfPage: new URL(`/articles/${article.id}/`, SITE_URL).href,
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: category.name, item: new URL(`/category/${category.slug}/`, SITE_URL).href },
    { '@type': 'ListItem', position: 2, name: d.title },
  ],
};
---
<Base title={d.title} description={d.description} jsonLd={[ld, crumbLd]} image={og?.src}>
  <article class="prose">
    <p class="crumb"><a href={`/category/${category.slug}/`}>{category.name}</a>・{KINDS[d.kind as keyof typeof KINDS]}</p>
    <h1>{d.title}</h1>
    <p class="date">
      {d.updatedDate ? <>更新於 <time datetime={fmt(d.updatedDate)}>{fmt(d.updatedDate)}</time></> : <time datetime={fmt(d.pubDate)}>{fmt(d.pubDate)}</time>}
      {d.brands.length > 0 && <>　適用：{d.brands.join('、')}</>}
    </p>
    {d.cover && (
      <figure class="cover">
        <Image src={d.cover} alt={d.cover_alt ?? ''} widths={[480, 760, 1140]} sizes="(max-width: 640px) 100vw, 38em" loading="eager" fetchpriority="high" />
        <figcaption>情境示意圖（AI 生成），非特定品牌型號。</figcaption>
      </figure>
    )}
    {d.takeaways && (
      <aside class="takeaways" aria-label="重點">
        <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}
    <Content />
    <section class="sources">
      <h2>資料來源</h2>
      <ul>{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a>（{s.checked} 查證）</li>)}</ul>
      <p>型號不同，代碼意思可能不一樣。以你家機器的說明書為準。</p>
    </section>
  </article>
  <ArticleRail headings={headings} />
</Base>

<style>
  .crumb, .date { font-size: .9rem; color: var(--muted); margin: 0; }
  .prose h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.35; margin: .3em 0 .3em; }
  .takeaways { margin: 24px 0 8px; padding: 16px 20px; border-left: 6px solid var(--tile); background: var(--card); border-radius: 0 6px 6px 0; }
  .takeaways ul { margin: 0; padding-left: 1.2em; }
  .cover { margin: 20px 0 0; }
  .cover img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 6px; }
  .cover figcaption { font-size: .8rem; color: var(--muted); margin-top: 6px; }
  .sources { margin-top: 3em; padding-top: 8px; border-top: 1px solid var(--rule); font-size: .92rem; color: var(--muted); }
  .sources h2 { font-size: 1.1rem; margin: 1em 0 .4em; }
</style>
