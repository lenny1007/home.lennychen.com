---
import '../styles/global.css';
import { ADSENSE_CLIENT, CATEGORIES, SITE_NAME, SITE_DESCRIPTION, SITE_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 額外的 JSON-LD 物件 */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** og:image 的絕對或站內路徑 */
  image?: string;
}
const { title, description = SITE_DESCRIPTION, jsonLd = [], noindex = false, image } = Astro.props;
const fullTitle = title ? `${title}｜${SITE_NAME}` : `${SITE_NAME}｜家電錯誤碼、清潔保養與廚具知識`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: SITE_URL, inLanguage: 'zh-Hant-TW' };
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    {image && <meta property="og:image" content={new URL(image, SITE_URL).href} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@700&display=swap" />
    {ADSENSE_CLIENT && !noindex && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}
    {[siteLd, ...jsonLd].map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <header class="site wrap">
      <a class="brand" href="/">
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="var(--tile)"/><path d="M7 16 16 8l9 8v9H7z" fill="var(--paper)"/><rect x="13.5" y="18" width="5" height="7" fill="var(--tile)"/></svg>
        {SITE_NAME}
      </a>
      <nav aria-label="主要分類">
        {CATEGORIES.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site wrap">
      <span>{SITE_NAME}・home.lennychen.com</span>
      <span><a href="/articles/">全部文章</a>・<a href="/knowledge/">影片重點卡</a>・<a href="/about/">關於本站</a></span>
    </footer>
  </body>
</html>

<style>
  header.site { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px; border-bottom: 1px solid var(--rule); }
  .brand { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 700; font-size: 1.2rem; text-decoration: none; }
  .brand svg { width: 30px; height: 30px; flex: none; }
  nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: .95rem; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--ink); }
  footer.site { margin-top: 32px; padding-block: 40px 56px; border-top: 1px solid var(--rule); color: var(--muted); font-size: .9rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  @media (max-width: 560px) { nav { width: 100%; gap: 14px; } }
</style>
