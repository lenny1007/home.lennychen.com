---
// 冷氣濾網自己洗四步（大金、日立、國際牌台灣說明書共通做法）
---
<svg viewBox="0 0 480 470" role="img" aria-label="冷氣濾網清洗四步：停機關電源、掀開面板抽出濾網、吸塵或用中性清潔劑洗（水溫 40℃ 以下）、陰涼處晾乾再裝回">
  <!-- 分隔線 -->
  <path class="dash" d="M240 10 V460 M10 235 H470" />

  <!-- ① 停機、關電源 -->
  <circle class="ac" cx="24" cy="26" r="14" /><text class="tw" x="24" y="31" text-anchor="middle">1</text>
  <text class="tx" x="46" y="32">停機、關電源</text>
  <rect class="fl" x="30" y="60" width="170" height="48" rx="10" /><rect class="ln" x="30" y="60" width="170" height="48" rx="10" />
  <path class="ln-thin" d="M45 96 H185" />
  <rect class="fl" x="85" y="128" width="40" height="58" rx="4" /><rect class="ln" x="85" y="128" width="40" height="58" rx="4" />
  <rect class="ac" x="97" y="158" width="16" height="20" rx="3" />
  <text class="tm" x="136" y="152">電源開關</text>
  <text class="tm" x="136" y="172">切到關</text>
  <text class="tm" x="24" y="216">先停止運轉，再關電源</text>

  <!-- ② 掀開面板、抽出濾網 -->
  <circle class="ac" cx="264" cy="26" r="14" /><text class="tw" x="264" y="31" text-anchor="middle">2</text>
  <text class="tx" x="286" y="32">掀開面板、抽出濾網</text>
  <rect class="ac" x="270" y="54" width="170" height="9" rx="4" />
  <path class="ac-ln" d="M452 74 V52 M445 60 L452 52 L459 60" />
  <rect class="fl" x="270" y="72" width="170" height="40" rx="10" /><rect class="ln" x="270" y="72" width="170" height="40" rx="10" />
  <rect class="pp" x="300" y="138" width="110" height="52" rx="4" /><rect class="ln" x="300" y="138" width="110" height="52" rx="4" />
  <path class="ln-thin" d="M318 138 V190 M336 138 V190 M354 138 V190 M372 138 V190 M390 138 V190 M300 155 H410 M300 172 H410" />
  <path class="ac-ln" d="M355 116 V132 M348 125 L355 132 L362 125" />
  <text class="tm" x="420" y="168">濾網</text>
  <text class="tm" x="264" y="216">面板掀開，濾網往外拉出</text>

  <!-- ③ 吸塵，髒再用中性清潔劑 -->
  <circle class="ac" cx="24" cy="262" r="14" /><text class="tw" x="24" y="267" text-anchor="middle">3</text>
  <text class="tx" x="46" y="268">吸塵，髒再用中性清潔劑</text>
  <rect class="pp" x="34" y="298" width="110" height="70" rx="4" /><rect class="ln" x="34" y="298" width="110" height="70" rx="4" />
  <path class="ln-thin" d="M52 298 V368 M70 298 V368 M88 298 V368 M106 298 V368 M124 298 V368 M34 321 H144 M34 344 H144" />
  <path class="ln" d="M150 312 L176 300 L184 316 L158 328 Z" />
  <path class="ln" d="M182 308 C205 300 215 330 205 352" />
  <path class="wt" d="M60 380 q5 8 0 12 q-5 -4 0 -12 Z M90 382 q5 8 0 12 q-5 -4 0 -12 Z M120 380 q5 8 0 12 q-5 -4 0 -12 Z" />
  <rect class="ac" x="156" y="368" width="70" height="26" rx="13" />
  <text class="tw" x="191" y="386" text-anchor="middle">≤ 40℃</text>
  <text class="tm" x="24" y="450">不用熱水，溫水 40℃ 以下</text>

  <!-- ④ 陰涼處晾乾、裝回 -->
  <circle class="ac" cx="264" cy="262" r="14" /><text class="tw" x="264" y="267" text-anchor="middle">4</text>
  <text class="tx" x="286" y="268">陰涼處晾乾，再裝回</text>
  <path class="ln" d="M282 300 L340 286 L398 300" />
  <rect class="pp" x="300" y="310" width="80" height="78" rx="4" /><rect class="ln" x="300" y="310" width="80" height="78" rx="4" />
  <path class="ln-thin" d="M316 310 V388 M332 310 V388 M348 310 V388 M364 310 V388 M300 336 H380 M300 362 H380" />
  <circle class="ln" cx="432" cy="330" r="13" />
  <path class="ln-thin" d="M432 306 V311 M432 349 V354 M408 330 H413 M451 330 H456 M415 313 L419 317 M445 343 L449 347 M449 313 L445 317 M419 343 L415 347" />
  <path class="ac-ln" d="M412 352 L452 308" />
  <text class="tm" x="264" y="430">避免日曬；濾網沒裝回</text>
  <text class="tm" x="264" y="450">不要開機</text>
</svg>
